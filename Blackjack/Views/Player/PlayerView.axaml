<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:player="clr-namespace:Blackjack.ViewModels.Player"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Blackjack.Views.Player.PlayerView"
             x:DataType="{x:Type player:PlayerViewModel}">
    
    <Border Padding="12">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="28"/>
            </StackPanel>
            <ContentControl Grid.Row="1" Content="{Binding Hand}" Margin="12"/>
            <StackPanel HorizontalAlignment="Center" Grid.Row="2">
                <TextBlock Text="Bet amount placeholder" FontSize="20"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
