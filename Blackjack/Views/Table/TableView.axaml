<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:table="clr-namespace:Blackjack.ViewModels.Table"
             xmlns:card="clr-namespace:Blackjack.ViewModels.Card"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Blackjack.Views.Table.TableView"
             x:DataType="table:TableViewModel">

    <StackPanel>
        <Button Command="{Binding DrawCard}">Trekken</Button>
        <Grid ColumnDefinitions="200,200,200,200">
            <ListBox ItemsSource="{Binding Cards}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type card:CardViewModel}">
                        <StackPanel>
                            <Image Height="300" Width="200" Source="{Binding Image}" />
                            <Button Command="{Binding Flip}">Flip</Button>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </StackPanel>
</UserControl>