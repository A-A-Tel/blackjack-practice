<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:menu="clr-namespace:Blackjack.ViewModels.Menu"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Blackjack.Views.Menu.TitleView"
             x:DataType="menu:TitleViewModel">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center">
            <TextBlock FontSize="40" Text="Welcome to BlackJack!" />
            <StackPanel HorizontalAlignment="Center">
                <Button Command="{Binding GoToTable}">Go to test</Button>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>