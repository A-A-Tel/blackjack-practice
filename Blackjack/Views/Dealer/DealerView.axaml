<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:player="clr-namespace:Blackjack.ViewModels.Player"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Blackjack.Views.Player.DealerView"
             x:DataType="{x:Type player:DealerViewModel}">
    <Border Padding="12">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Dealer" FontSize="28" />
            </StackPanel>
            <Grid HorizontalAlignment="Center" Grid.Row="2" RowDefinitions="Auto" ColumnDefinitions="Auto, Auto" ColumnSpacing="50" Margin="12">
                <ContentControl Content="{Binding Hand}"/>
                <ContentControl Grid.Column="1" Content="{Binding Shoe}" MaxWidth="100"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
